{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(bash scripts/verify.sh)",
      "Bash(bash scripts/verify.sh:*)",
      "Bash(npm run build)",
      "Bash(npx jasmine:*)",
      "Bash(uv run pytest:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./backend/gcp-oauth.keys.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-syntax.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
