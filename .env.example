# Variables read by docker compose for ${...} substitution (copy to ./.env).
# Backend application settings live in backend/.env (see backend/.env.example).
# Never commit the real .env files.

# Self-hosted Langfuse project keys (create them in the Langfuse UI at http://localhost:3001)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse server secrets. Keep stable once set: changing SALT invalidates existing Langfuse API keys.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Optional OpenTelemetry export (traces), e.g. http://otel-collector:4317
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local models (defaults shown)
LLM_DEFAULT_MODEL=qwen3:8b-q8_0
RAG_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434
